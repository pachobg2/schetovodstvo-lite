<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>9.0</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <AssemblyName>SchetovodstvoLite</AssemblyName>
    <RootNamespace>SchetovodstvoLite</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.3.1</Version>
    <Product>Счетоводство Lite</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\web\*.*" Exclude="..\web\_*.*" LogicalName="web/%(Filename)%(Extension)" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>
  <!-- the WebView2 DLLs go INSIDE the exe (single-file app); Program.cs loads them from the resources -->
  <Target Name="EmbedDeps" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.2792.45\lib\net462\Microsoft.Web.WebView2.Core.dll" LogicalName="dep/Microsoft.Web.WebView2.Core.dll" />
      <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.2792.45\lib\net462\Microsoft.Web.WebView2.WinForms.dll" LogicalName="dep/Microsoft.Web.WebView2.WinForms.dll" />
      <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.2792.45\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="dep/WebView2Loader.dll" />
    </ItemGroup>
  </Target>
</Project>
